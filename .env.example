# ==============================================================================
# PhishGuard X - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your credentials.
# ==============================================================================

# Database Configuration (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/phishguard_db

# Docker Compose Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=phishguard_db

# Security & Authentication (JWT)
# Generate a strong 32+ character random secret for production: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_secure_random_jwt_secret_key_minimum_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Threat Intelligence Providers
# URLhaus Auth Key (Optional for basic API, required for authenticated feeds)
URLHAUS_AUTH_KEY=

# Local Ollama AI Assistant & Knowledge Base (RAG)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_EMBED_MODEL=nomic-embed-text
